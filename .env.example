# ── Database ─────────────────────────────────────────────
# Leave empty locally to use a SQLite file in ./data.
# Required on Vercel: Supabase → Connect → "Transaction pooler" URI (port 6543).
DATABASE_URL=

# ── Access ───────────────────────────────────────────────
# Turns on the login screen. Required on Vercel (the app refuses to serve data without it).
SETLO_PASSWORD=

# ── AI / integrations (all optional, each degrades gracefully) ──
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
DEEPGRAM_API_KEY=
GHL_API_TOKEN=
GHL_LOCATION_ID=

# ── Advanced ─────────────────────────────────────────────
# SETLO_WORKSPACE_ID=ws_demo
# SETLO_SEED=false          # start with an empty workspace instead of demo leads
# SETLO_DB_PATH=./data/setlo.db
